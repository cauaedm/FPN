# ──────────────────────────────────────────────────────────────
# Automação de Extensões IC/UFRJ — Variáveis de Ambiente
# Copie para .env e preencha os valores (nunca suba o .env ao Git)
# ──────────────────────────────────────────────────────────────

# ── E-MAIL ─────────────────────────────────────────────────────
# Backend: "smtp" (padrão) ou "resend" (API HTTP, porta 443).
# Use "resend" quando o host bloquear SMTP de saída (ex.: Railway grátis).
EMAIL_BACKEND=smtp

# Resend (quando EMAIL_BACKEND=resend): crie a chave em resend.com
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM no plano grátis: onboarding@resend.dev (ou um domínio verificado)

# Servidor SMTP institucional da UFRJ (ou Gmail para testes) — backend "smtp"
EMAIL_HOST=smtp.ufrj.br
EMAIL_PORT=587
EMAIL_USER=ic-extensoes@ic.ufrj.br
EMAIL_PASSWORD=sua_senha_aqui
EMAIL_FROM="IC/UFRJ Extensões <ic-extensoes@ic.ufrj.br>"
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false

# Exemplo com Gmail (para desenvolvimento/testes):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=seu@gmail.com
# EMAIL_PASSWORD=app_password_aqui  # Gere em: myaccount.google.com/apppasswords
# EMAIL_FROM=seu@gmail.com
# EMAIL_USE_TLS=true

# ── TELEGRAM ───────────────────────────────────────────────────
# Obtenha o token com @BotFather no Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# IDs separados por vírgula. Use @nome para canais públicos,
# número negativo para grupos, número positivo para usuários.
TELEGRAM_CHAT_IDS=-1001234567890,@ic_ufrj_extensoes

# ── WHATSAPP ───────────────────────────────────────────────────
# Backend: "evolution" (padrão, self-hosted) ou "twilio"
WHATSAPP_BACKEND=evolution

# Números destino separados por vírgula (formato: DDI+DDD+número)
# Ex: 5521999999999 para (21) 99999-9999 no Brasil
WHATSAPP_NUMEROS=5521999999999,5521888888888

# Evolution API (backend=evolution):
EVOLUTION_API_URL=https://api.suainstancia.com
EVOLUTION_API_KEY=sua_chave_evolution
EVOLUTION_INSTANCE=ic-ufrj

# Twilio (backend=twilio):
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+14155238886  # número do sandbox Twilio

# ── SCHEDULER (opcional) ───────────────────────────────────────
# Dias da semana (mon, tue, wed, thu, fri, sat, sun ou *)
CRON_DAY_OF_WEEK=mon,thu
CRON_HOUR=9
CRON_MINUTE=0

# ── WEB SERVICE (FastAPI) ──────────────────────────────────────
# Painel do Comitê (RF06-09): usuário e senha compartilhados.
COMITE_USER=comite
COMITE_PASSWORD=defina_uma_senha_forte

# Origem(ns) permitida(s) no CORS — domínio do site que consome a API.
# Separe por vírgula. Ex.: https://cauaedm.github.io
ALLOWED_ORIGIN=https://cauaedm.github.io
